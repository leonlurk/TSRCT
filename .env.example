# TSRCT settings. `npm run setup` writes .env for you; or copy this to .env and fill it in.
# Only the first block is required.

# ── core ─────────────────────────────────────────────────────────────────────
BRIDGE_TOKEN=change-me-to-a-long-random-string   # the master token (log in with it, from this machine)
BRIDGE_PORT=3847
BIND_HOST=127.0.0.1             # keep it local; reach it remotely through Tailscale, never 0.0.0.0
TMUX_SESSION=                   # empty: TSRCT adopts the first real session it finds
TZ=America/New_York             # the scheduler and the morning routine read local time
PROJECTS_ROOT=/home/you/PROJECTS
SESSION_IDLE_HOURS=12           # a login stays alive while used, up to this idle time

# ── restricted projects (never sent to any AI service, never leave the machine) ──
RESTRICTED_PROJECTS=secretco    # comma-separated names; replace the example
DESK_RESTRICTED_HOSTS=          # extra hostnames the PC eyes must never look at

# ── optional: your vault, Windows, the headless browser ───────────────────────
VAULT_ROOT=/home/you/PROJECTS/vault
WIN_HOME=                       # /mnt/c/Users/you - turns on the Windows (PC) features
HEADLESS_DIR=/home/you/headless-chrome   # puppeteer-core + chrome-headless-shell for the Projector

# ── optional: the morning routine ─────────────────────────────────────────────
MORNING_ENABLED=0
MORNING_AT=06:00
MORNING_MAX_SESSIONS=4

# ── optional: Tesla, the voice assistant ──────────────────────────────────────
TALK_NAME=Tesla
TALK_BRAIN=haiku                # haiku (a hidden Claude Code session) or local (Ollama)
TALK_MODEL=qwen2.5:3b-instruct-q4_K_M   # the local model, when TALK_BRAIN=local
HERMES_AUTOSTART=0              # 1 preloads the local model at boot
TALK_VOICE=                     # a Piper voice or a profile in lib/tts.js
TESLA_LOG=1                     # every conversation to logs/tesla/ (gitignored)

# ── optional: phone alerts and calls (npm run setup makes a private topic) ───
NTFY_SERVER=https://ntfy.sh     # or your own ntfy server on the tailnet
NTFY_TOPIC=                     # empty: no phone alerts. A topic is a public name: make it unguessable

# Everything else (timeouts, models, file locations) has a default in the code:
# search for process.env.<NAME> to see it.
